menu "Car Customize Config"

menu "Choose Car model Config"
    #选择机器人类型
    choice
        prompt "select Types of robot" 
        default CORE_USING_INFANTRY
        config CORE_USING_INFANTRY  #步兵
            bool "infantry"
        config CORE_USING_HERO      #英雄
            bool "hero"
		config CORE_USING_SENTRY    #哨兵
			bool "sentry"
		config CORE_USING_ENGINEER  #工程
			bool "engineer"			
    endchoice
    #当为哨兵时
    if  CORE_USING_SENTRY
        choice
            prompt "select Types of sentry robot" 
            default CORE_USING_OMNI_SENTRY
              
            #全向轮哨兵-26新
            config CORE_USING_OMNI_SENTRY
                bool "omni wheel sentry"    

            #麦轮哨兵-退役于2024-被全向轮哨兵取代
            config CORE_USING_MECANUM_SENTRY
                bool "mecanum sentry"    
            
            #舵轮哨兵-2025年研发，因为在联盟赛上总是被肘击而光荣退役
            config CORE_USING_STEER_SENTRY
                bool "steer sentry"               
        endchoice
    endif

    #当为普通步兵时
    if  CORE_USING_INFANTRY
        choice
           	prompt "select Types of infantry robot" 
            default CORE_USING_2025_INFANTRY_1

            #2024全向轮步兵-目前还没名字
            config CORE_USING_2024_INFANTRY_OMNI
                bool "2024 infantry OMNI"  

            config CORE_USING_2025_INFANTRY_1   
                bool "2025 infantry 1 zhijiao"              #2025步兵1(按照出车时间排序)

            config CORE_USING_2025_INFANTRY_2
                bool "2025 infantry 2 daojiao"              #2025步兵2

            config CORE_USING_2025_INFANTRY_3
                bool "2025 infantry 3 omni"                 #2025步兵3
            
            config CORE_USING_2026_INFANTRY_1
                bool "2026 infantry 1 omni"                 #2026步兵1
            
            config CORE_USING_2026_INFANTRY_2
                bool "2026 infantry 2 omni"                 #2026步兵2

            #2024麦轮步兵-飞将-轮距很窄-左右容易晃；轮子大-为飞坡设计-但飞坡效果并不理想
            config CORE_USING_2024_NEW_INFANTRY
                bool "2024 new infantry"            
                             
            #碳板步兵-老学长-性能还很不错
            config CORE_USING_CARBON_INFANTRY
                bool "carbon infantry"

            #瓦力步兵-2023复刻的碳步-但是各方面性能都不如碳步-很差
            config CORE_USING_WALL_E_INFANTRY
                bool "wall_e infantry"

        endchoice
    endif

    #当为英雄时
    if  CORE_USING_HERO
        choice
            prompt "select Types of hero robot" 
            default CORE_USING_2026_HERO
          
            #2024英雄-骁将
            config CORE_USING_2026_HERO
                bool "2026 hero"

            #英雄双马尾
            config CORE_USING_BUNCHES_HERO
                bool "SMW hero"

            #复刻老英雄
            config CORE_USING_NEW_OLD_HERO
                bool "old-sub hero"

            #老英雄
            config CORE_USING_NATION_HERO
                bool "old hero"

        endchoice

    endif

endmenu 



#底盘相关配置 每次更改兵种最好检查一下有无更改部分
menu "Board function module"

    choice #选择超级电容类型
        prompt "select superCap kind"
        default USE_CAPACITY_3
        
        #超级电容并联
        config USE_CAPACITY_3
            bool "select superCap_3"
    endchoice    

    menu "CAN device set"
        config GIMBAL_CAN_DEVICE_NAME       #云台CAN设备名称
            int "the specific gimbal can device"
            default "2"

        config SCPR_CAN_DEVICE_NAME            #超级电容CAN设备名称
            int "the specific superCap can device"
            default "1"
    endmenu

    #是否开启rtt监视
    config CORE_USING_RTT_MONITOR
        bool "Enable RTT monitor"
        default n

    #是否进行底盘测试
    menuconfig CORE_USING_TEST
        bool "Enable test chassis"
        default n   

    menuconfig BSP_USING_VOFA    
        bool "select using vofa"
        depends on CORE_USING_TEST     
        default n    

        config BSP_TEST_USART_NAME          #调试数据可视化串口
            string "the specific vofa usart device"
            depends on BSP_USING_VOFA     
            default "uart3"
        config BSP_TEST_USART_BOUD          #vofa波特率
            int "the vofa usart bound"
            depends on BSP_USING_VOFA 
            default "115200"

    menuconfig CORE_USING_REMOTE        #遥控器直接调试底盘
        bool "use dji remote"
        depends on CORE_USING_TEST
        default n                  
        config BSP_REMOTE_USART_NAME        #遥控器串口
            string "the specific remote usart device"
            depends on CORE_USING_REMOTE
            default "uart6"

    #是否需要使用和视觉通信的串口
    menuconfig BSP_USING_VISUAL_USART
        bool "Use visual com"
        default n
        depends on CORE_USING_SENTRY

        config BSP_VISUAL_USART_NAME         
            string "the specific Visual usart device"
            depends on BSP_USING_VISUAL_USART  
            default "uart2"  
        config BSP_VISUAL_USART_BOUD
            int "the Visual usart bound"
            depends on BSP_USING_VISUAL_USART  
            default "115200"

        if BSP_USING_VISUAL_USART
            choice
                prompt "select Types of usart" 
                default VISUAL_USART_USING_NORMAL
                config VISUAL_USART_USING_NORMAL  #普通串口
                    bool "normal usart"
                config VISUAL_USART_USING_RS485  #RS485串口(不能同时收发)
                    bool "usart-RS485"	
            endchoice
        endif
endmenu #menu "Board function module"




endmenu

