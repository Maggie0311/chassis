CONFIG_BSP_USING_ON_CHIP_FLASH=y
CONFIG_BSP_USING_GPIO=y
CONFIG_BSP_USING_UART=y
CONFIG_BSP_USING_UART1=y
CONFIG_BSP_UART1_RX_USING_DMA=y
CONFIG_BSP_UART1_TX_USING_DMA=y
CONFIG_BSP_USING_UART2=y
CONFIG_BSP_UART2_RX_USING_DMA=y
CONFIG_BSP_UART2_TX_USING_DMA=y
# CONFIG_BSP_USING_UART3 is not set
CONFIG_BSP_USING_UART4=y
CONFIG_BSP_UART4_RX_USING_DMA=y
# CONFIG_BSP_UART4_TX_USING_DMA is not set
CONFIG_BSP_USING_UART6=y
CONFIG_BSP_UART6_RX_USING_DMA=y
CONFIG_BSP_UART6_TX_USING_DMA=y
CONFIG_BSP_USING_PWM=y
CONFIG_BSP_USING_PWM1=y
CONFIG_BSP_USING_PWM1_CH1=y
CONFIG_BSP_USING_PWM1_CH2=y
CONFIG_BSP_USING_PWM1_CH3=y
CONFIG_BSP_USING_PWM1_CH4=y
CONFIG_BSP_USING_PWM4=y
CONFIG_BSP_USING_PWM4_CH1=y
CONFIG_BSP_USING_PWM4_CH2=y
CONFIG_BSP_USING_PWM4_CH3=y
CONFIG_BSP_USING_PWM4_CH4=y
CONFIG_BSP_USING_PWM9=y
CONFIG_BSP_USING_PWM9_CH1=y
CONFIG_BSP_USING_PWM9_CH2=y
CONFIG_BSP_USING_SPI=y
CONFIG_BSP_USING_SPI1=y
# CONFIG_BSP_SPI1_TX_USING_DMA is not set
# CONFIG_BSP_SPI1_RX_USING_DMA is not set
CONFIG_BSP_USING_SPI2=y
# CONFIG_BSP_SPI2_TX_USING_DMA is not set
# CONFIG_BSP_SPI2_RX_USING_DMA is not set
CONFIG_BSP_USING_CAN=y
CONFIG_BSP_USING_CAN1=y
CONFIG_BSP_USING_CAN2=y
# CONFIG_BSP_USING_HARDFAULT_RESET is not set
CONFIG_BSP_USING_DSP=y

#
# Board extended module Drivers
#

#
# Car Customize Config
#

#
# Choose Car model Config
#

#
# Set chassis wheel_kind
#
# CONFIG_RF_USING_MECANUM_WHEEL is not set
CONFIG_RF_USING_OMNI_WHEEL=y
# CONFIG_RF_USING_STEER_WHEEL is not set
# CONFIG_LF_USING_MECANUM_WHEEL is not set
CONFIG_LF_USING_OMNI_WHEEL=y
# CONFIG_LF_USING_STEER_WHEEL is not set
# CONFIG_LB_USING_MECANUM_WHEEL is not set
CONFIG_LB_USING_OMNI_WHEEL=y
# CONFIG_LB_USING_STEER_WHEEL is not set
# CONFIG_RB_USING_MECANUM_WHEEL is not set
CONFIG_RB_USING_OMNI_WHEEL=y
# CONFIG_RB_USING_STEER_WHEEL is not set

#
# Chassis CAN device set
#
CONFIG_RF_CAN_DEVICE_NAME=1
CONFIG_LF_CAN_DEVICE_NAME=1
CONFIG_LB_CAN_DEVICE_NAME=1
CONFIG_RB_CAN_DEVICE_NAME=1

#
# Set chassis moter kind
#
CONFIG_WHEEL_MOTOR_3508=y
# CONFIG_WHEEL_MOTOR_2006 is not set
# CONFIG_WHEEL_MOTOR_DM_8006 is not set
CONFIG_STEER_MOTOR_6020=y
# CONFIG_STEER_MOTOR_3508 is not set
# CONFIG_STEER_MOTOR_DM_4310 is not set
# CONFIG_STEER_MOTOR_DM_6006 is not set

#
# Set gimbal motor kind
#
CONFIG_YAW_MOTOR_6020=y
# CONFIG_YAW_MOTOR_3508 is not set
# CONFIG_YAW_MOTOR_DM is not set
CONFIG_PITCH_MOTOR_6020=y
# CONFIG_PITCH_MOTOR_3508 is not set
# CONFIG_PITCH_MOTOR_DM is not set
# CONFIG_CORE_USING_INFANTRY is not set
CONFIG_CORE_USING_HERO=y
# CONFIG_CORE_USING_SENTRY is not set
# CONFIG_CORE_USING_ENGINEER is not set
# CONFIG_CORE_USING_2024_INFANTRY_OMNI is not set
# CONFIG_CORE_USING_2025_INFANTRY_1 is not set
# CONFIG_CORE_USING_2025_INFANTRY_2 is not set
# CONFIG_CORE_USING_2025_INFANTRY_3 is not set
# CONFIG_CORE_USING_2026_INFANTRY_1 is not set
# CONFIG_CORE_USING_2024_NEW_INFANTRY is not set
# CONFIG_CORE_USING_CARBON_INFANTRY is not set
# CONFIG_CORE_USING_WALL_E_INFANTRY is not set
CONFIG_CORE_USING_2026_HERO=y
# CONFIG_CORE_USING_BUNCHES_HERO is not set
# CONFIG_CORE_USING_NEW_OLD_HERO is not set
# CONFIG_CORE_USING_NATION_HERO is not set

#
# Board function module
#
# CONFIG_USE_CAPACITY_2 is not set
CONFIG_USE_CAPACITY_3=y
# CONFIG_BSP_USING_SPI_Master is not set
# CONFIG_BSP_USING_CHASSIS_IMU is not set

#
# CAN device set
#
CONFIG_GIMBAL_CAN_DEVICE_NAME=2
CONFIG_IMU_GIMBAL_CAN_DEVICE_NAME=2
CONFIG_IMU_CHASSIS_CAN_DEVICE_NAME=1
CONFIG_SCPR_CAN_DEVICE_NAME=1
# CONFIG_CORE_USING_RTT_MONITOR is not set
# CONFIG_CORE_USING_TEST is not set
CONFIG_BSP_USING_VISUAL_USART=y
CONFIG_BSP_VISUAL_USART_NAME="uart2"
CONFIG_BSP_VISUAL_USART_BOUD=115200
CONFIG_VISUAL_USART_USING_NORMAL=y
# CONFIG_VISUAL_USART_USING_RS485 is not set
